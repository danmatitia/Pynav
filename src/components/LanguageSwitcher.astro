
---
import { languages, getText } from '../i18n';

import { pathFor } from '../config/paths';

const { lang, translations } = Astro.props;
---

<div
  class="lang-switcher"
  role="group"
  aria-label={getText(lang).nav.langLabel}
>
  {languages.map((language) => (
    <a
      href={pathFor(translations[language.code] ?? `${language.code}/`)}
      hreflang={language.code}
      lang={language.code}
      aria-current={language.code === lang && translations[lang] !== undefined ? 'page' : undefined}
    >
      {language.code.toUpperCase()}
    </a>
  ))}
</div>
