
---
import { Image } from 'astro:assets';
import icon from '../assets/app-store/icon.png';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getText } from '../i18n';

import { pathFor } from '../config/paths';

const { lang, translations } = Astro.props;
const t = getText(lang);

const home = pathFor(`${lang}/`);

const links = [
  { href: `${home}#usages`, label: t.nav.usages },
  { href: `${home}#fonctionnalites`, label: t.nav.features },
  { href: `${home}#compatibilite`, label: t.nav.compat },
  { href: `${home}#tarifs`, label: t.nav.pricing },
  { href: pathFor(`${lang}/faq/`), label: t.nav.faq },
];
---

<header class="header">
  <div class="container header__inner">

    <a class="logo" href={home}>
      <Image src={icon} width={36} height={36} loading="eager" alt="" />
      <span class="logo__name">Py<span>Nav</span></span>
    </a>

    <nav class="nav nav--desktop" aria-label={t.nav.main}>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="nav">
      <LanguageSwitcher {lang} {translations} />

      <details class="menu">
        <summary>{t.nav.menu}</summary>
        <nav aria-label={t.nav.main}>
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </details>
    </div>

  </div>
</header>
