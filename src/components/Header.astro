
---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getText } from '../i18n';

const { lang } = Astro.props;
const t = getText(lang);

// Chemin de base pour GitHub Pages (/Pynav/)
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}${lang}/#usages`, label: t.nav.usages },
  { href: `${base}${lang}/#fonctionnalites`, label: t.nav.features },
  { href: `${base}${lang}/#compatibilite`, label: t.nav.compat },
  { href: `${base}${lang}/#tarifs`, label: t.nav.pricing },
  { href: `${base}${lang}/#faq`, label: t.nav.faq },
];
---

<header class="header">
  <div class="container header__inner">

    <a class="logo" href={`${base}${lang}/`}>
      Py<span>Nav</span>
    </a>

    <nav class="nav nav--desktop" aria-label={t.nav.main}>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="nav">
      <LanguageSwitcher lang={lang} />

      <details class="menu">
        <summary>{t.nav.menu}</summary>
        <nav aria-label={t.nav.main}>
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </details>
    </div>

  </div>
</header>
