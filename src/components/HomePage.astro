---
// Contenu de l'accueil. Les phrases se modifient dans src/i18n/*.ts, pas ici.
import { Picture } from 'astro:assets';
import dashboard from '../assets/app-store/dashboard.webp';
import autopilot from '../assets/app-store/autopilot.webp';
import wind from '../assets/app-store/wind.webp';
import cockpit from '../assets/marine/cockpit.webp';
import sailing from '../assets/marine/sailing.webp';
import { pathFor } from '../config/paths';
import { sections, sectionPath } from '../config/editorial';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadButtons from './DownloadButtons.astro';
import FeatureCard from './FeatureCard.astro';
import { getText } from '../i18n';
const { lang } = Astro.props;
const t = getText(lang);
const fr = lang === 'fr';
const resourceDescriptions = fr
  ? ['Connectez pypilot et affichez vos instruments sur iPhone.', 'Vérifiez le format de sortie de votre passerelle NMEA.', 'Comparez les protocoles et trouvez des conseils pour votre réseau de bord.']
  : ['Connect pypilot and display your instruments on iPhone.', 'Check which data format your NMEA gateway sends.', 'Compare protocols and get tips for your onboard network.'];
const home = new URL(pathFor(), Astro.site).href;
const organization = { '@type': 'Organization', '@id': `${home}#organization`, name: site.name, url: home };
const structuredData = [
  organization,
  {
    '@type': 'SoftwareApplication', name: site.name, description: t.meta.description,
    operatingSystem: site.downloads.googlePlay ? 'iOS, iPadOS, Android' : 'iOS, iPadOS',
    applicationCategory: 'UtilitiesApplication', downloadUrl: site.downloads.appStore,
    publisher: { '@id': organization['@id'] },
  },

];
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} {structuredData}>

  <!-- SECTION HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <h1>{t.hero.title}</h1>
        <p>{t.hero.subtitle}</p>
        <DownloadButtons lang={lang} />
      </div>
      <figure class="hero-product">
        <Picture src={autopilot} formats={['avif', 'webp']} widths={[240, 360, 560]}
          sizes="(max-width: 430px) 70vw, 300px" loading="eager" fetchpriority="high"
          alt={fr ? 'Écran PyNav de commande du pilote automatique pypilot' : 'PyNav screen with pypilot autopilot controls'} />
        <figcaption>{fr ? 'Commande pypilot sur iPhone' : 'pypilot controls on iPhone'}</figcaption>
      </figure>
    </div>
  </section>

  <!-- SECTION USAGES : pypilot ET NMEA -->
  <section class="section section--alt" id="usages">
    <div class="container">
      <h2>{t.usages.title}</h2>
      <div class="grid grid--2">{t.usages.items.map((i) => <FeatureCard title={i.title} text={i.text} />)}</div>
    </div>
  </section>

  <!-- SECTION FONCTIONNALITÉS -->
  <section class="section" id="fonctionnalites">
    <div class="container">
      <h2>{t.features.title}</h2>
      <div class="grid grid--3">{t.features.items.map((i) => <FeatureCard title={i.title} text={i.text} />)}</div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>{lang === 'fr' ? 'PyNav en images' : 'See PyNav in action'}</h2>
      <div class="app-screenshots">
        <figure>
          <Picture src={dashboard} formats={['avif', 'webp']} widths={[240, 360, 560]}
            sizes="(max-width: 400px) 70vw, 280px"
            alt={fr ? 'Tableau de bord PyNav avec cadrans de navigation' : 'PyNav dashboard with marine navigation gauges'} />
          <figcaption>{fr ? 'Tableau de bord NMEA' : 'NMEA dashboard'}</figcaption>
        </figure>
        <figure>
          <Picture src={wind} formats={['avif', 'webp']} widths={[240, 360, 560]}
            sizes="(max-width: 400px) 70vw, 280px"
            alt={lang === 'fr' ? 'Écran PyNav affichant les instruments de vent' : 'PyNav screen showing wind instruments'} />
          <figcaption>{lang === 'fr' ? 'Instruments de vent' : 'Wind instruments'}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- SECTION COMPATIBILITÉ -->
  <section class="section section--alt" id="compatibilite">
    <div class="container">
      <h2>{t.compat.title}</h2>
      <p class="muted">{t.compat.text}</p>
      <ul class="badges">{t.compat.protocols.map((p) => <li>{p}</li>)}</ul>
      <p class="muted">{t.compat.limits}</p>
    </div>
  </section>

  <nav class="container resource-section" aria-labelledby="resources">
    <h2 id="resources">{fr ? 'Préparez votre installation' : 'Set up your boat'}</h2>
    <ul class="resource-grid">
      {(['docs', 'compatibility', 'blog'] as const).map((section, index) => (
        <li>
          <a class="resource-card" href={pathFor(sectionPath(lang, section))}>
            <span class="resource-card__title">{sections[lang as 'fr' | 'en'][section][1]} <span aria-hidden="true">↗</span></span>
            <span>{resourceDescriptions[index]}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- SECTION GRATUIT / PRO (aucun prix affiché tant qu'il n'est pas vérifié) -->
  <section class="section" id="tarifs">
    <div class="container">
      <h2>{t.pricing.title}</h2>
      <div class="grid grid--2">
        <FeatureCard title={t.pricing.free.title} text={t.pricing.free.text} />
        <FeatureCard title={t.pricing.pro.title} text={t.pricing.pro.text} class="card--pro" />
      </div>
      <p class="muted">{t.pricing.note}</p>
    </div>
  </section>

  <!-- SECTION FAQ : questions dans src/i18n/*.ts -->
  <section class="section section--alt faq" id="faq">
    <div class="container">
      <h2>{t.faq.title}</h2>
      {t.faq.items.map((i) => <details><summary>{i.q}</summary><p>{i.a}</p></details>)}
    </div>
  </section>

  <section class="container sailing-photos" aria-label={fr ? 'En mer' : 'On the water'}>
    <Picture src={cockpit} formats={['avif', 'webp']} widths={[360, 720, 1080]}
      sizes="(max-width: 740px) 95vw, 48vw"
      alt={fr ? 'Vue depuis le cockpit d’un voilier sur une mer turquoise' : 'View from a sailboat cockpit over turquoise water'} />
    <Picture src={sailing} formats={['avif', 'webp']} widths={[360, 720, 1080]}
      sizes="(max-width: 740px) 95vw, 48vw"
      alt={fr ? 'Vue aérienne d’un voilier et de son sillage sur la mer bleue' : 'Aerial view of a sailboat and its wake on blue water'} />
  </section>

  <!-- SECTION APPEL FINAL -->
  <section class="section cta">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p class="muted">{t.cta.text}</p>
      <DownloadButtons lang={lang} />
    </div>
  </section>
</BaseLayout>
